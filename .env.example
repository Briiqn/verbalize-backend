# Copy to .env (or ../server/.env) and fill in. Never commit the real file.
GEMINI_API_KEY=your-gemini-key
ELEVENLABS_API_KEY=your-elevenlabs-key
GEMINI_MODEL=gemini-3.1-flash-lite

# MariaDB (HikariCP via Hibernate)
DB_URL=jdbc:mariadb://127.0.0.1:3306/verbalize
DB_USER=root
DB_PASSWORD=change-me

# Optional
PORT=8080
VERBALIZE_DIST=dist
